+/** Powerline U+E0B0-E0B7, drawn inside the cell box and filling its full height. */
+function drawPowerline(
+  ctx: Ctx2D,
+  cp: number,
+  x: number,
+  y: number,
+  w: number,
+  h: number,
+  light: number
+): void {
+  const n = cp - 0xe0b0;
+  const solid = n % 2 === 0;
+  const right = n < 2 || (n >= 4 && n < 6);
+  const round = n >= 4;
+  const style = ctx.fillStyle;
+  ctx.save();
+  ctx.beginPath();
+  ctx.rect(x, y, w, h);
+  ctx.clip();
+  ctx.beginPath();
+  if (round) {
+    const fx = right ? x : x + w;
+    ctx.ellipse(fx, y + h / 2, w, h / 2, 0, right ? -Math.PI / 2 : Math.PI / 2, right ? Math.PI / 2 : (3 * Math.PI) / 2);
+    if (solid) ctx.closePath();
+  } else {
+    const tipX = right ? x + w : x;
+    const baseX = right ? x : x + w;
+    ctx.moveTo(baseX, y);
+    ctx.lineTo(tipX, y + h / 2);
+    ctx.lineTo(baseX, y + h);
+    if (solid) ctx.closePath();
+  }
+  if (solid) {
+    ctx.fill();
+  } else {
+    ctx.strokeStyle = style;
+    ctx.lineWidth = light;
+    ctx.lineCap = 'butt';
+    ctx.lineJoin = 'miter';
+    ctx.stroke();
+  }
+  ctx.restore();
+}
