#!/bin/sh
# scripts/test-changed [--dry-run] [<base>]: runs the Rust tests that the changed files can reach, which is
# `cpd test changed` (docs/commands.md §26.1; docs/implementing.md "The scoped loop" is the contract).
# Cargo builds and executes this checkout's cpd, including when its target directory is customized.
set -eu

cd "$(dirname "$0")/.."

exec scripts/cargo.sh run -q -p cpd --bin cpd -- test changed "$@"
