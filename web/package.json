{
  "name": "cpd-web-client",
  "version": "0.0.0",
  "private": true,
  "productName": "CPD",
  "type": "module",
  "description": "The cpd web client (browser UI with cockpit parity) against the typed API mock (hs-d780)",
  "main": "dist-electron/main.js",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview:on": "sh ../scripts/preview-web.sh on",
    "preview:off": "sh ../scripts/preview-web.sh off",
    "preview:reload": "sh ../scripts/preview-web.sh reload",
    "dist:mac": "pnpm run build:electron && electron-builder --mac",
    "build:electron": "CPD_ELECTRON_TARGET=renderer vite build -c vite.electron.config.ts && CPD_ELECTRON_TARGET=main vite build -c vite.electron.config.ts && CPD_ELECTRON_TARGET=preload vite build -c vite.electron.config.ts",
    "electron": "pnpm run build:electron && chmod +x node_modules/node-pty/prebuilds/*/spawn-helper && if [ \"$(node -p process.platform)\" = darwin ]; then for k in CFBundleName CFBundleDisplayName; do plutil -replace $k -string CPD node_modules/electron/dist/Electron.app/Contents/Info.plist; done; fi && electron .",
    "e2e": "playwright test",
    "e2e:install": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@aurigax-ai/ghostty-web": "0.3.9",
    "@base-ui/react": "1.9.0",
    "@earendil-works/chord": "1.5.0",
    "cn": "0.5.2",
    "node-pty": "1.1.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ai": "7.0.159",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "jsdom": "30.1.3",
    "lucide-react": "1.65.0",
    "nanoid": "6.0.2",
    "playwright": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.15.3",
    "react-router-dom": "7.18.5",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "use-stick-to-bottom": "1.1.6",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
