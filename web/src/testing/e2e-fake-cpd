#!/usr/bin/env node
// Scripted fake `cpd` for the desktop e2e suite (Plan desktop-e2e).
//
// The Electron app spawns a real cpd for its whole data plane: the long-lived
// `cpd cockpit serve` NDJSON stream (docs/contract.md §5.5, protocol 1), the
// `cpd events follow` stream, and one-shot JSON execs (`context list`,
// `plan show`, config reads/writes, ...). Point CPD_BIN at this file, or put a
// `cpd` symlink to it first on PATH, and the app boots against deterministic
// empty state with no daemon, no store and no network.
//
// Every one-shot exec prints exactly one `{"ok":true,...}` JSON object, the
// shape `web/src/server/cockpit/cli.ts` demands. The panes of a snapshot carry
// the same `ok` object the matching list command prints (`context list`,
// `plan list`, `session list`, `inbox list`), as `web/src/server/cockpit/`
// reads them. It uses only Node globals, so it runs under either module system.

"use strict";

const { existsSync } = await import("node:fs");

// ---- output ---------------------------------------------------------------

/** One NDJSON line on stdout. */
function emit(value) {
  process.stdout.write(JSON.stringify(value) + "\n");
}

// ---- pane replies: the shape the app's parsers expect ---------------------

const cursor = 0;

/**
 * The serve `status` pane (CONTRACT §20): the engine's Worker counts and incident state, as
 * `cpd cockpit serve` carries it on every snapshot. The suite's status path reads it directly,
 * with no tmux scrape, so the Workers segment and the incident pill show live serve data.
 * CPD_FAKE_INCIDENT=1 makes the fake report an open incident (the incident-pill scenario);
 * otherwise incident is off. The counts are fixed so the Workers segment's text is predictable.
 */
const statusPane = () => ({
  ok: true,
  workers: { queued: 3, waiting: 2, running: 4, limit: 6 },
  incident:
    process.env.CPD_FAKE_INCIDENT === "1"
      ? { on: true, started_at: new Date().toISOString(), lead: null }
      : { on: false, started_at: null, lead: null },
});

const contextPane = () => ({ ok: true, events_cursor: cursor, contexts: [] });
const planPane = () => ({ ok: true, events_cursor: cursor, plans: [] });
const sessionPane = () => ({ ok: true, events_cursor: cursor, sessions: [] });
const inboxPane = () => ({
  ok: true,
  events_cursor: cursor,
  items: [],
  hidden: { claimed: 0, dismissed: 0, snoozed: 0 },
  engine: { running: false },
});

/** A full snapshot of the panes; `seq` counts from 1. */
function snapshot(seq) {
  return {
    t: "snapshot",
    seq,
    panes: {
      context: contextPane(),
      plan: planPane(),
      session: sessionPane(),
      inbox: inboxPane(),
      status: statusPane(),
    },
  };
}

/** `cpd plan show` reply, the value a `plan_show` frame carries. */
function planShow(id) {
  return {
    ok: true,
    events_cursor: cursor,
    plan: {
      id,
      context: "cpd",
      title: "Fake plan",
      phase: "draft",
      archived_at: null,
      lead_session: null,
    },
    counts: { draft: 0, queued: 0, running: 0, merged: 0, failed: 0, cancelled: 0 },
    jobs: [],
    workflows: [],
    review: null,
    escalations: [],
    reviewed_pr: null,
  };
}

// ---- cockpit serve: the NDJSON request/response stream --------------------

/** Read stdin line by line; `onLine` gets each complete line, `onEnd` the EOF. */
function readLines(onLine, onEnd) {
  let buffered = "";
  process.stdin.setEncoding("utf8");
  process.stdin.on("data", (chunk) => {
    buffered += chunk;
    let nl = buffered.indexOf("\n");
    while (nl >= 0) {
      const line = buffered.slice(0, nl);
      buffered = buffered.slice(nl + 1);
      if (line.trim() !== "") onLine(line);
      nl = buffered.indexOf("\n");
    }
  });
  process.stdin.on("end", onEnd);
  process.stdin.on("error", onEnd);
  process.stdin.resume();
}

function cockpitServe() {
  emit({ t: "hello", protocol: 1 });
  let seq = 0;
  let opened = false;
  let pending = false;
  const emitSnapshot = () => {
    seq += 1;
    emit(snapshot(seq));
  };
  // CPD_FAKE_GATE names a file to wait for before the first snapshot. The workers spec sets it so
  // the app's initial (no-pane) status read lands first, then opens the gate: the pane-triggered
  // status read is then the last write, with no last-writer-wins race. Unset, the fake emits at once.
  const gate = process.env.CPD_FAKE_GATE;
  const release = () => {
    if (opened) return;
    opened = true;
    emitSnapshot();
    if (pending) {
      pending = false;
      emitSnapshot();
    }
  };
  if (gate === undefined) release();
  else {
    const watch = setInterval(() => {
      if (existsSync(gate)) {
        clearInterval(watch);
        release();
      }
    }, 25);
  }
  readLines(
    (line) => {
      let request;
      try {
        request = JSON.parse(line);
      } catch {
        emit({ t: "error", id: null, error: { code: "bad_request", message: "line is not JSON" } });
        return;
      }
      const t = request && typeof request === "object" ? request.t : undefined;
      if (t === "refresh") {
        if (opened) emitSnapshot();
        else pending = true;
      } else if (t === "plan_show") {
        const id = typeof request.id === "string" ? request.id : null;
        const plan = typeof request.plan === "string" ? request.plan : "";
        emit({ t: "plan_show", id, value: planShow(plan) });
      } else {
        emit({ t: "error", id: null, error: { code: "bad_request", message: `unknown request ${String(t)}` } });
      }
    },
    () => {
      // Stdin EOF: write nothing more and exit 0 (the parent's death closes it, so no orphan).
    },
  );
}

// ---- one-shot commands ----------------------------------------------------

/** The context of a `events follow` line: an Event (`web/src/server/cockpit/events.ts`) that also carries `ok`. */
function fakeEvent() {
  return {
    ok: true,
    id: 1,
    kind: "watch-started",
    at: "1970-01-01T00:00:00.000Z",
    text: "",
    plan: null,
    context: null,
    session: null,
    job: null,
    attempt: null,
    data: {},
  };
}

/** Keep a streaming command alive (stdin is /dev/null for the app's follow child, so it cannot gate on EOF). */
function stayAlive() {
  const timer = setInterval(() => {}, 1 << 30);
  const stop = () => {
    clearInterval(timer);
    process.exit(0);
  };
  process.on("SIGTERM", stop);
  process.on("SIGINT", stop);
  process.stdout.on("error", stop);
}

function eventsCommand(args) {
  const mode = args[0];
  if (mode === "follow") {
    emit(fakeEvent());
    if (args.includes("--until-idle")) return; // a bounded read: one line, then exit 0
    stayAlive();
    return;
  }
  emit({ ok: true, events: [] });
}

function planCommand(args) {
  const mode = args[0];
  if (mode === "list") {
    emit(planPane());
    return;
  }
  if (mode === "show") {
    let id = null;
    const at = args.indexOf("--plan");
    if (at >= 0 && typeof args[at + 1] === "string") id = args[at + 1];
    else if (typeof args[1] === "string" && !args[1].startsWith("-")) id = args[1];
    emit(planShow(id ?? ""));
    return;
  }
  emit({ ok: true });
}

function contextCommand(args) {
  if (args[0] === "list") {
    emit(contextPane());
    return;
  }
  if (args[0] === "curation") {
    emit({ ok: true, retire: [] });
    return;
  }
  emit({ ok: true });
}

function sessionCommand(args) {
  if (args[0] === "list") {
    emit(sessionPane());
    return;
  }
  emit({ ok: true });
}

function inboxCommand(args) {
  if (args[0] === "list") {
    emit(inboxPane());
    return;
  }
  emit({ ok: true });
}

function configCommand(args) {
  if (args[0] === "experimental" && args.length === 1) {
    emit({
      ok: true,
      experimental: { durable_workers: false, write_curation: false, failure_triage: false, turn_question_guard: false },
    });
    return;
  }
  if (args[0] === "show") {
    emit({ ok: true, config: { experimental: { durable_workers: false } } });
    return;
  }
  if (args.length === 0) {
    emit({
      ok: true,
      config: { context_distill_tier: "G1", worker_tier: "G1", lead_tier: "G1", manager_tier: "G1" },
    });
    return;
  }
  emit({ ok: true });
}

/** The pty runs `cpd tui --attach`: print a banner and stay live like a cockpit. */
function tuiCommand() {
  process.stdout.write("cpd tui --attach (fake)\n");
  stayAlive();
}

// ---- dispatch -------------------------------------------------------------

const argv = process.argv.slice(2);
const command = argv[0];
const rest = argv.slice(1);

switch (command) {
  case "cockpit":
    if (rest[0] === "serve") cockpitServe();
    else emit({ ok: true });
    break;
  case "events":
    eventsCommand(rest);
    break;
  case "context":
    contextCommand(rest);
    break;
  case "plan":
    planCommand(rest);
    break;
  case "session":
    sessionCommand(rest);
    break;
  case "inbox":
    inboxCommand(rest);
    break;
  case "config":
    configCommand(rest);
    break;
  case "attempt":
    emit({ ok: true, attempts: [] });
    break;
  case "incident":
    emit({ ok: true, on: false });
    break;
  case "tui":
    tuiCommand();
    break;
  case "--version":
    emit({ ok: true, version: "0.0.0", protocol: 25 });
    break;
  default:
    emit({ ok: true });
}
