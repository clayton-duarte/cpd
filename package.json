{
  "name": "cpd",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n daemon,web -c cyan,magenta \"pnpm daemon\" \"pnpm dev\"",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run && pnpm --filter @cpd/daemon test",
    "test:watch": "vitest",
    "daemon": "node --watch --experimental-strip-types daemon/src/index.ts"
  },
  "dependencies": {
    "@mantine/core": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@tabler/icons-react": "^3.31.0",
    "@xyflow/react": "^12.12.0",
    "elkjs": "^0.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.17.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "jsdom": "^30.1.2",
    "typescript": "~5.6.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
